# ==========================================================
# HeyLook Local Environment Variables
# Copy this file to `.env.local` and fill in your real keys.
# ==========================================================

# Gemini API Key (required for Hymli AI / Gemini calls)
# IMPORTANT: Vite only exposes variables prefixed with VITE_ to the browser.
# Get a key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY="your_real_api_key_here"

# Optional: override the default Gemini model (defaults to gemini-2.5-flash)
VITE_GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this app is hosted (used for OAuth redirects).
APP_URL="http://localhost:3000"

# Supabase Credentials
VITE_SUPABASE_URL="your_supabase_url_here"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Web Push public key (safe to expose in the browser; keep the private key in Supabase secrets)
VITE_VAPID_PUBLIC_KEY="your_vapid_public_key_here"

# Paystack Public Key (for payments)
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key_here"
